# Local dev database (docker compose up -d db)
DATABASE_URL=postgresql://feast:feast@localhost:5432/feastmath

# Generate per machine: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Free key: aistudio.google.com → Get API key (no card needed)
GEMINI_API_KEY=
# Optional override; defaults to gemini-2.5-flash
GEMINI_MODEL=

# Google Cloud OAuth client (Phase 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to 1 for offline demo plans (no LLM API calls at all)
FEAST_MOCK_PLAN=
